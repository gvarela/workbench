#!/bin/bash -p
#
# test-integrity: deterministic test-integrity evidence since a starting commit.
#
# Reports, as JSON on stdout, the test files changed since --start (committed,
# staged, unstaged, and untracked), whether each outer test is unchanged since
# its red commit (the whole file byte for byte; or, when several --red name
# the same file, every line that red commit added, still present and still
# blamed on it), skip or focus markers added since --start, deleted test
# files and removed test definitions, and changed test files missing from a
# declared list. With --plan-start, it also lists the test files changed
# between the plan's start and --start that are changed again since --start.
# It decides nothing: the caller interprets the result.
#
# It is safe in repositories you do not control: bash 3.2 and git only, and
# read-only (git reads a temporary copy of the index; nothing in the
# repository is written).
#
# Exit status: 0 whenever it produced JSON (problems go in "errors"),
# 2 on a usage error.

usage() {
    cat >&2 <<'EOF'
Usage: test-integrity --start <commit> [options]
       test-integrity --fingerprint [--include-ignored <dir>]...
       test-integrity --sha256 <part> [<part>...]

  --start <commit>          Commit the task began from (required).
  --red <commit>:<path>     An outer test file and its red commit (repeatable).
  --declared <file>         File listing, one per line, the test files the
                            reports declare.
  --declared-path <path>    One declared test file (repeatable; combines with
                            --declared), so no list file is needed.
  --declared-none           A declared set with nothing in it: every changed
                            test file is undeclared. Without any of the three
                            declared options, undeclared_changes is null.
  --test-paths <spec>       What counts as a test file (repeatable; replaces the
                            defaults). "dir/" matches a directory anywhere in the
                            path, a spec with "/" is a glob on the whole path,
                            anything else is a glob on the file name. A plain
                            name that is a directory at the top level ("tests")
                            counts as "tests/".
                            Default: spec/ test/ tests/ __tests__/ *_test.*
                            *_spec.* test_*.py *.test.* *.spec.*
  --skip-pattern <regex>    Extended regex for a skip or focus marker (repeatable;
                            added to the built-in RSpec, pytest, Jest/Vitest, Go,
                            and Minitest patterns).
  --plan-start <commit>     Commit the plan began from. Lists the test files
                            changed between it and --start (earlier phases) that
                            are changed again since --start. Without it,
                            earlier_phase_tests is null.
  --allow-mechanical        Leave mechanical changes (import re-sorts,
                            edge-whitespace-only changes, or leading
                            comment-block changes; see "mechanical") out of
                            undeclared_changes, listing them in
                            cleared_mechanical instead. Without it,
                            cleared_mechanical is null.
  --fingerprint             Instead of the report, print one JSON object
                            {"fingerprint": "<sha256>", "records": n} over the
                            tree's state: index entries, status, the working
                            tree of tracked paths, untracked files, and
                            ignored files under each --include-ignored
                            directory. No --start needed.
  --include-ignored <dir>   With --fingerprint: also cover ignored files under
                            this repository-relative directory (repeatable;
                            capped at 20000 files and 500 MiB).
  --sha256 <part>...        Print {"sha256": "<hex>", "bytes": n} for the exact
                            concatenation of the parts (no separators; every
                            remaining argument is a part, even one starting
                            with -). No git needed; at most 1 MiB in total.

Paths in --red, --declared, --declared-path, and the output are relative to the
repository root.
EOF
    exit 2
}

# Take no optional locks; the index itself is protected by the temporary copy
# set up after the cd below.
export GIT_OPTIONAL_LOCKS=0
# Run nothing the repository configures: no system config, hooks, fsmonitor,
# global attributes, external diff, or pager, and (where git supports it)
# attributes read from the empty tree, so no filter or textconv driver named
# in .gitattributes runs.
# The "-p" on the first line keeps bash from sourcing BASH_ENV/ENV or
# importing exported functions; inherited GIT_* variables (GIT_DIR,
# GIT_WORK_TREE, GIT_CONFIG_*, GIT_EXTERNAL_DIFF, ...) are dropped so only
# the settings below steer git.
for _v in $(compgen -e); do
    case "$_v" in GIT_*|BASH_ENV|ENV|CDPATH) unset "$_v" ;; esac
done
export GIT_OPTIONAL_LOCKS=0 GIT_CONFIG_NOSYSTEM=1 GIT_ATTR_NOSYSTEM=1
GIT_ATTR_SRC=()
if git --attr-source=4b825dc642cb6eb9a060e54bf8d69288fbee4904 version >/dev/null 2>&1; then
    GIT_ATTR_SRC=(--attr-source=4b825dc642cb6eb9a060e54bf8d69288fbee4904)
fi
g() {
    git --no-optional-locks ${GIT_ATTR_SRC[@]+"${GIT_ATTR_SRC[@]}"} -c core.hooksPath=/dev/null -c core.fsmonitor=false \
        -c core.attributesFile=/dev/null -c diff.external= -c core.pager=cat "$@"
}
gdiff() { g diff --no-ext-diff --no-textconv --no-color "$@"; }

SEP=$'\037'

# ---------------------------------------------------------------- arguments
START=""
PLAN_START=""
DECLARED=""
DECLARED_GIVEN=""
ALLOW_MECH=""
SHA_MODE=""
SHA_PARTS=()
FINGERPRINT=""
INCLUDE_IGNORED=()
DECLARED_ARGS=""
REDS=()
TEST_PATHS=()
SKIP_PATTERNS=()
ORIG_PWD="$PWD"

while [ $# -gt 0 ]; do
    case "$1" in
        --start)        [ $# -ge 2 ] || usage; START="$2"; shift 2 ;;
        --red)          [ $# -ge 2 ] || usage; case "$2" in *:?*) ;; *) usage ;; esac
                        REDS[${#REDS[@]}]="$2"; shift 2 ;;
        --declared)     [ $# -ge 2 ] || usage; DECLARED="$2"; DECLARED_GIVEN=1; shift 2 ;;
        --declared-path) [ $# -ge 2 ] && [ -n "$2" ] || usage
                        DECLARED_ARGS="$DECLARED_ARGS${2#./}"$'\n'; DECLARED_GIVEN=1; shift 2 ;;
        --declared-none) DECLARED_GIVEN=1; shift ;;
        --allow-mechanical) ALLOW_MECH=1; shift ;;
        --fingerprint)  FINGERPRINT=1; shift ;;
        --sha256)       shift; [ $# -ge 1 ] || usage
                        SHA_MODE=1; SHA_PARTS=("$@"); break ;;
        --include-ignored) [ $# -ge 2 ] && [ -n "$2" ] || usage
                        case "$2" in /*|-*) usage ;; esac
                        case "/$2/" in */../*) usage ;; esac
                        INCLUDE_IGNORED[${#INCLUDE_IGNORED[@]}]="${2%/}"; shift 2 ;;
        --plan-start)   [ $# -ge 2 ] || usage; PLAN_START="$2"; shift 2 ;;
        --test-paths)   [ $# -ge 2 ] || usage; TEST_PATHS[${#TEST_PATHS[@]}]="$2"; shift 2 ;;
        --skip-pattern) [ $# -ge 2 ] || usage; SKIP_PATTERNS[${#SKIP_PATTERNS[@]}]="$2"; shift 2 ;;
        -h|--help)      usage ;;
        *)              usage ;;
    esac
done
sha256_stdin() {
    if command -v shasum >/dev/null 2>&1; then shasum -a 256 | cut -d' ' -f1
    elif command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1
    else openssl dgst -sha256 -r | cut -d' ' -f1
    fi
}

# --sha256: the digest of the exact concatenation of the parts; no git.
if [ -n "$SHA_MODE" ]; then
    SHA_BYTES="$(printf '%s' "${SHA_PARTS[@]}" | wc -c | tr -d ' ')"
    if [ "$SHA_BYTES" -gt 1048576 ]; then
        echo "test-integrity: --sha256 parts total $SHA_BYTES bytes, over the 1 MiB limit" >&2
        exit 2
    fi
    printf '{"sha256":"%s","bytes":%s}\n' "$(printf '%s' "${SHA_PARTS[@]}" | sha256_stdin)" "$SHA_BYTES"
    exit 0
fi

[ -n "$START" ] || [ -n "$FINGERPRINT" ] || usage

if [ ${#TEST_PATHS[@]} -eq 0 ]; then
    TEST_PATHS=('spec/' 'test/' 'tests/' '__tests__/' '*_test.*' '*_spec.*' 'test_*.py' '*.test.*' '*.spec.*')
fi

# A word that is not part of a longer identifier.
W_START='(^|[^[:alnum:]_])'
W_END='([^[:alnum:]_]|$)'
SKIP_PATTERNS=(
    "${W_START}(xit|xtest|xdescribe|xcontext|xspecify|xexample|xscenario|fit|fdescribe|fcontext|fspecify|fexample|fscenario|skip|skipif|pending|xfail)${W_END}"
    "${W_START}focus:|:focus${W_END}"
    "\\.only${W_END}"
    "\\.Skip(Now|f)?[[:space:]]*\\("
    ${SKIP_PATTERNS[@]+"${SKIP_PATTERNS[@]}"}
)

# Lines that define a test in common frameworks (used for removed definitions).
DEF_PATTERNS=(
    "^[[:space:]]*(it|test|specify|example|scenario|describe|context)[[:space:]]*[(\"']"
    "^[[:space:]]*(async[[:space:]]+)?def[[:space:]]+test"
    "^[[:space:]]*func[[:space:]]+Test"
    "^[[:space:]]*@Test"
)

# ---------------------------------------------------------------- helpers
ERRORS=""

# json_str <string>: print the string as a JSON string literal.
json_str() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    case "$s" in
        *[$'\001'-$'\037']*)
            local out="" c i code
            for ((i = 0; i < ${#s}; i++)); do
                c="${s:i:1}"
                case "$c" in
                    [$'\001'-$'\037'])
                        printf -v code '%d' "'$c"
                        out="$out$(printf '\\u%04x' "$code")" ;;
                    *) out="$out$c" ;;
                esac
            done
            s="$out" ;;
    esac
    printf '"%s"' "$s"
}

# append <var name> <json value>: add an element to a comma-separated list.
append() {
    eval "local cur=\"\${$1}\""
    if [ -n "$cur" ]; then
        eval "$1=\"\$cur,\$2\""
    else
        eval "$1=\"\$2\""
    fi
}

add_error() { append ERRORS "$(json_str "$1")"; }

is_test_path() {
    local p="$1" base="${1##*/}" spec
    for spec in "${TEST_PATHS[@]}"; do
        case "$spec" in
            */)
                case "$p" in "$spec"*|*/"$spec"*) return 0 ;; esac ;;
            */*)
                # shellcheck disable=SC2254
                case "$p" in $spec) return 0 ;; esac ;;
            *)
                # shellcheck disable=SC2254
                case "$base" in $spec) return 0 ;; esac ;;
        esac
    done
    return 1
}

matches_any() {
    local text="$1" re
    shift
    for re in "$@"; do
        [[ $text =~ $re ]] && return 0
    done
    return 1
}

# diff_lines <diff args...>: one record per hunk (H), added line (A, new line
# number), and removed line (D, old line number), fields separated by SEP.
diff_lines() {
    gdiff -U0 "$@" | awk -v sep="$SEP" '
        /^diff --git / { inhunk = 0; next }
        /^@@/ {
            inhunk = 1
            split($0, f, " ")
            o = substr(f[2], 2); sub(/,.*/, "", o)
            n = substr(f[3], 2); sub(/,.*/, "", n)
            print "H" sep 0 sep ""
            next
        }
        !inhunk { next }
        /^\+/ { print "A" sep n sep substr($0, 2); n++; next }
        /^-/  { print "D" sep o sep substr($0, 2); o++; next }
    '
}

# ---------------------------------------------------------------- setup
TOP="$(g rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$TOP" ]; then
    echo "test-integrity: not inside a git work tree" >&2
    exit 2
fi
case "$DECLARED" in
    ""|/*) ;;
    *) DECLARED="$ORIG_PWD/$DECLARED" ;;
esac
cd "$TOP" || exit 2

# Every filter, diff, and merge driver configured for this repository is
# overridden with an empty command, so one named by .gitattributes or
# .git/info/attributes never runs (GIT_CONFIG_KEY/VALUE accept any name).
CFG_N=0
set_cfg() {
    export "GIT_CONFIG_KEY_$CFG_N=$1" "GIT_CONFIG_VALUE_$CFG_N=$2"
    CFG_N=$((CFG_N + 1))
    export GIT_CONFIG_COUNT=$CFG_N
}
while IFS= read -r -d '' key; do
    case "$key" in
        filter.*.*)
            name="${key#filter.}"; name="${name%.*}"
            set_cfg "filter.$name.clean" ""; set_cfg "filter.$name.smudge" ""
            set_cfg "filter.$name.process" ""; set_cfg "filter.$name.required" false ;;
        diff.*.*)
            name="${key#diff.}"; name="${name%.*}"
            set_cfg "diff.$name.textconv" ""; set_cfg "diff.$name.command" "" ;;
        merge.*.*)
            name="${key#merge.}"; name="${name%.*}"
            set_cfg "merge.$name.driver" "" ;;
    esac
done < <(git config -z --name-only --get-regexp '^(filter|diff|merge)\..*\.' 2>/dev/null)

# A plain name that is a directory at the top level ("tests") means that
# directory, as "tests/" does; read as a file-name glob it would match nothing
# and silently report no changed tests.
for i in "${!TEST_PATHS[@]}"; do
    case "${TEST_PATHS[$i]}" in
        */*|*[*?[]*) ;;
        *) [ -d "${TEST_PATHS[$i]}" ] && TEST_PATHS[$i]="${TEST_PATHS[$i]}/" ;;
    esac
done

# norm_path <path>: one spelling per file, so --red arguments that name the
# same file match: "./spec/a.rb", "spec//a.rb", and "spec/./a.rb" all become
# "spec/a.rb". Sets NORM.
norm_path() {
    NORM="$1"
    while :; do
        case "$NORM" in
            ./*)   NORM="${NORM#./}" ;;
            *//*)  NORM="${NORM%%//*}/${NORM#*//}" ;;
            */./*) NORM="${NORM%%/./*}/${NORM#*/./}" ;;
            *)     return ;;
        esac
    done
}
NORM_REDS=()
for spec in ${REDS[@]+"${REDS[@]}"}; do
    norm_path "${spec#*:}"
    NORM_REDS[${#NORM_REDS[@]}]="${spec%%:*}:$NORM"
done
REDS=(${NORM_REDS[@]+"${NORM_REDS[@]}"})

# Diffing a commit against the work tree rewrites the index when a file is
# stat-dirty, even with optional locks off. Work on a throwaway copy so the
# repository's index is never written.
REAL_INDEX="$(g rev-parse --git-path index)"
TMP_INDEX="$(mktemp)" || exit 2
trap 'rm -f "$TMP_INDEX" "$TMP_INDEX.lock" "$TMP_INDEX.mech" "$TMP_INDEX.mech.ra" "$TMP_INDEX.mech.rb" "$TMP_INDEX.mech.ba" "$TMP_INDEX.mech.bb" "$TMP_INDEX.fpr" "$TMP_INDEX.fpl" "$TMP_INDEX.fpp" "$TMP_INDEX.fph" "$TMP_INDEX.fpu"' EXIT
# Keep the index's mtime (git uses it to spot same-second edits); with no
# index, remove the empty file so git starts without one.
if [ -f "$REAL_INDEX" ]; then cp -p "$REAL_INDEX" "$TMP_INDEX"; else rm -f "$TMP_INDEX"; fi
export GIT_INDEX_FILE="$TMP_INDEX"

START_SHA="$(g rev-parse --verify --quiet "$START^{commit}")"
[ -n "$START_SHA" ] || add_error "start commit not found: $START"

# With no index git sees every tracked file as deleted and re-added. Seed the
# temporary index from HEAD, which is what a real index would hold, so only
# real changes show (from the start commit when HEAD does not resolve).
if [ ! -f "$REAL_INDEX" ]; then
    SEED="$(g rev-parse --verify --quiet HEAD^{commit})"
    [ -n "$SEED" ] || SEED="$START_SHA"
    if [ -n "$SEED" ]; then
        g read-tree "$SEED" 2>/dev/null ||
            add_error "repository has no index and it could not be rebuilt from HEAD"
    fi
fi

# ---------------------------------------------------------------- fingerprint
# --fingerprint: one sha256 over NUL-framed records of the tree's state, in a
# deterministic order: the index (path, mode, blob, stage), the status
# (git status --porcelain=v2 -z, tracked entries), the working tree of every
# tracked path (mode and blob, or "deleted"; a submodule's checked-out
# commit), untracked files, and ignored files under each --include-ignored
# directory (path, mode, content blob, or a symlink target's blob). Each
# record is its fields, each ended by NUL, then one more NUL. Read-only.
MAX_IGNORED_FILES=20000
MAX_IGNORED_KB=512000
# Tracked and untracked content is capped too (100,000 files, 2 GiB read);
# over a cap the fingerprint fails closed. TEST_INTEGRITY_FP_MAX_FILES and
# TEST_INTEGRITY_FP_MAX_KB may only lower the caps.
lower_cap() {
    case "$2" in ""|*[!0-9]*) printf '%s' "$1" ;; *) if [ "$2" -lt "$1" ]; then printf '%s' "$2"; else printf '%s' "$1"; fi ;; esac
}
MAX_TREE_FILES="$(lower_cap 100000 "${TEST_INTEGRITY_FP_MAX_FILES:-}")"
MAX_TREE_KB="$(lower_cap 2097152 "${TEST_INTEGRITY_FP_MAX_KB:-}")"

# fp_paths <tag> <NUL list file> <records file>: one record per path.
FP_N=0
fp_paths() {
    local tag="$1" list="$2" rec="$3" plain="$TMP_INDEX.fpp" hashes="$TMP_INDEX.fph" p mode h
    : > "$plain"
    while IFS= read -r -d '' p; do
        if [ -f "$p" ] && [ ! -L "$p" ]; then
            case "$p" in *$'\n'*) ;; *) printf '%s\n' "$p" >> "$plain" ;; esac
        fi
    done < "$list"
    : > "$hashes"
    [ -s "$plain" ] && g hash-object --no-filters --stdin-paths < "$plain" > "$hashes"
    exec 3< "$hashes"
    while IFS= read -r -d '' p; do
        if [ -L "$p" ]; then
            mode=120000
            h="$(printf '%s' "$(readlink -- "$p")" | g hash-object --stdin)"
        elif [ -f "$p" ]; then
            mode=100644
            [ -x "$p" ] && mode=100755
            case "$p" in
                *$'\n'*) h="$(g hash-object --no-filters -- "$p")" ;;
                *) IFS= read -r h <&3 ;;
            esac
        elif [ -d "$p" ]; then
            mode=160000
            h="$(g -C "$p" rev-parse --verify --quiet HEAD 2>/dev/null)"
            [ -n "$h" ] || h=none
        else
            mode=000000 h=deleted
        fi
        printf '%s\0%s\0%s\0%s\0\0' "$tag" "$p" "$mode" "$h" >> "$rec"
        FP_N=$((FP_N + 1))
    done < "$list"
    exec 3<&-
}

fingerprint_mode() {
    local rec="$TMP_INDEX.fpr" list="$TMP_INDEX.fpl" ent meta path dir count kb err=""
    : > "$rec"
    # Index entries, as git stores them.
    while IFS= read -r -d '' ent; do
        meta="${ent%%$'\t'*}"
        path="${ent#*$'\t'}"
        printf 'index\0%s\0%s\0\0' "$path" "$meta" >> "$rec"
        FP_N=$((FP_N + 1))
    done < <(g ls-files -s -z)
    # Status (staged versus unstaged), as one length-prefixed record.
    g status --porcelain=v2 -z --untracked-files=no --ignored=no > "$list" 2>/dev/null
    printf 'status\0%s\0' "$(wc -c < "$list" | tr -d ' ')" >> "$rec"
    cat "$list" >> "$rec"
    printf '\0\0' >> "$rec"
    FP_N=$((FP_N + 1))
    # Working tree of the tracked paths, and untracked files, capped before
    # anything is read.
    local ulist="$TMP_INDEX.fpu"
    g ls-files -z > "$list"
    g ls-files -z --others --exclude-standard > "$ulist"
    count=$(( $(tr -cd '\0' < "$list" | wc -c) + $(tr -cd '\0' < "$ulist" | wc -c) ))
    if [ "$count" -gt "$MAX_TREE_FILES" ]; then
        err="tracked and untracked files: $count is over the $MAX_TREE_FILES-file cap"
    else
        kb="$(cat "$list" "$ulist" | xargs -0 du -skP 2>/dev/null | awk '{ t += $1 } END { print t + 0 }')"
        [ "$kb" -gt "$MAX_TREE_KB" ] && err="tracked and untracked files: ${kb} KiB is over the $MAX_TREE_KB KiB cap"
    fi
    if [ -z "$err" ]; then
        fp_paths worktree "$list" "$rec"
        fp_paths untracked "$ulist" "$rec"
    fi
    rm -f "$ulist"
    # Ignored files under the included directories, capped.
    for dir in ${INCLUDE_IGNORED[@]+"${INCLUDE_IGNORED[@]}"}; do
        [ -z "$err" ] || break
        [ -d "$dir" ] || continue
        g ls-files -z --others --ignored --exclude-standard -- "$dir" > "$list"
        count="$(tr -cd '\0' < "$list" | wc -c | tr -d ' ')"
        if [ "$count" -gt "$MAX_IGNORED_FILES" ]; then
            err="ignored files under $dir: $count is over the $MAX_IGNORED_FILES-file cap"; break
        fi
        kb=0
        [ "$count" -gt 0 ] && kb="$(xargs -0 du -skP < "$list" 2>/dev/null | awk '{ t += $1 } END { print t + 0 }')"
        if [ "$kb" -gt "$MAX_IGNORED_KB" ]; then
            err="ignored files under $dir: ${kb} KiB is over the $MAX_IGNORED_KB KiB cap"; break
        fi
        printf 'ignored-dir\0%s\0\0' "$dir" >> "$rec"
        FP_N=$((FP_N + 1))
        fp_paths ignored "$list" "$rec"
    done
    if [ -n "$err" ]; then
        printf '{"fingerprint":null,"records":0,"errors":[%s]}\n' "$(json_str "$err")"
    else
        printf '{"fingerprint":"%s","records":%s,"errors":[]}\n' "$(sha256_stdin < "$rec")" "$FP_N"
    fi
    rm -f "$rec" "$list" "$TMP_INDEX.fpp" "$TMP_INDEX.fph"
}

if [ -n "$FINGERPRINT" ]; then
    fingerprint_mode
    exit 0
fi

DECLARED_LIST="$DECLARED_ARGS"
if [ -n "$DECLARED" ]; then
    if [ -r "$DECLARED" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            line="${line%$'\r'}"
            line="${line#./}"
            [ -n "$line" ] && DECLARED_LIST="$DECLARED_LIST$line"$'\n'
        done < "$DECLARED"
    else
        add_error "declared list not readable: $DECLARED"
    fi
fi

is_declared() {
    case $'\n'"$DECLARED_LIST" in *$'\n'"$1"$'\n'*) return 0 ;; esac
    return 1
}

CHANGED=""
SKIPS=""
DELETED=""
UNDECLARED=""
OUTER=""
MECH=""
CLEARED=""

# indent_is_syntax <path>: files where leading whitespace is syntax
# (Python, YAML, Gherkin, make).
indent_is_syntax() {
    case "$1" in
        *.py|*.pyi|*.yaml|*.yml|*.feature|*.mk|Makefile|*/Makefile|GNUmakefile|*/GNUmakefile|makefile|*/makefile) return 0 ;;
    esac
    return 1
}

# import_strip <file> <bindings file>: every line that is NOT a qualifying
# import, prefixed with its line number, so a comparison of two versions
# requires every other line to stay exactly where it was. A qualifying import
# is a plain, top-level, single-binding import in the file's leading import
# region (after a shebang, encoding line, docstring, "use strict", or package
# line; then only such imports, blank lines, and comments): Python
# "import a.b" and "from a import b" (one unaliased name); JavaScript and
# TypeScript "import y from 'x'", "import {y} from 'x'", and
# "const|let|var y = require('x')"; Go plain "pkg" paths in a top import
# block or "import "pkg""; Java, Kotlin, and Scala "import a.b.C" (no
# wildcard, no alias, no static); C# "using A.B;" (no static, no alias); Rust
# "use a::b;" (no braces, glob, or alias). For each,
# the name it binds goes to the bindings file, so two imports binding the
# same name are refused: the last component for JVM, C#, and Rust, the last
# path element for Go, the module for Python "import a" (a dotted
# "import a.b" binds "a" and never qualifies), the imported name for Python
# "from a import b", and the local name for JavaScript. Aliased,
# multi-name, parenthesised, indented, conditional, side-effect (JavaScript
# "import 'x'", bare "require('x')", Ruby require), Go "_" and "." imports,
# and imports after the leading region are never qualifying.
import_strip() {
    local py=""
    case "$3" in *.py|*.pyi) py=1 ;; esac
    LC_ALL=C awk -v q="'" -v bfile="$2" -v py="$py" '
        function trimc(s) { sub(/[ \t]*((#|\/\/).*)?$/, "", s); return s }
        # keys <path> <separator>: the name the import binds, its last
        # component; two qualifying imports binding the same name conflict.
        function keys(p, sep,   n, a) { n = split(p, a, sep); return a[n] }
        function qual(l,   t, n, a) {
            B = ""
            t = trimc(l)
            # Python: "import a" only (a dotted "import a.b" binds "a" and is
            # not qualifying); elsewhere (JVM) "import a.b.C".
            if (py && t ~ /^import[ \t]+[A-Za-z_][A-Za-z0-9_]*$/) {
                sub(/^import[ \t]+/, "", t); B = keys(t, "."); return 1
            }
            if (!py && t ~ /^import[ \t]+[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*[ \t]*;?$/) {
                sub(/^import[ \t]+/, "", t); sub(/[ \t]*;$/, "", t); B = keys(t, "."); return 1
            }
            if (t ~ /^from[ \t]+\.*([A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*)?[ \t]+import[ \t]+[A-Za-z_][A-Za-z0-9_]*$/) {
                n = split(t, a, /[ \t]+/); B = keys(a[n], "."); return 1
            }
            if (t ~ ("^import[ \t]+[A-Za-z_$][A-Za-z0-9_$]*[ \t]+from[ \t]+" Q "[^\"" q "]+" Q "[ \t]*;?$")) {
                split(t, a, /[ \t]+/); B = keys(a[2], "."); return 1
            }
            if (t ~ ("^import[ \t]*\\{[ \t]*[A-Za-z_$][A-Za-z0-9_$]*[ \t]*\\}[ \t]*from[ \t]+" Q "[^\"" q "]+" Q "[ \t]*;?$")) {
                sub(/^import[ \t]*\{[ \t]*/, "", t); sub(/[ \t]*\}.*$/, "", t); B = keys(t, "."); return 1
            }
            if (t ~ ("^(const|let|var)[ \t]+[A-Za-z_$][A-Za-z0-9_$]*[ \t]*=[ \t]*require\\([ \t]*" Q "[^\"" q "]+" Q "[ \t]*\\)[ \t]*;?$")) {
                sub(/^(const|let|var)[ \t]+/, "", t); sub(/[ \t]*=.*$/, "", t); B = keys(t, "."); return 1
            }
            if (t ~ /^import[ \t]+"[^"]+"$/) { sub(/^import[ \t]+"/, "", t); sub(/"$/, "", t); B = keys(t, "/"); return 1 }
            if (t ~ /^using[ \t]+[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*[ \t]*;$/ && t !~ /^using[ \t]+static[ \t]/) {
                sub(/^using[ \t]+/, "", t); sub(/[ \t]*;$/, "", t); B = keys(t, "."); return 1
            }
            if (t ~ /^use[ \t]+[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)+[ \t]*;$/) {
                sub(/^use[ \t]+/, "", t); sub(/[ \t]*;$/, "", t); B = keys(t, "::"); return 1
            }
            return 0
        }
        BEGIN { Q = "[\"" q "]"; TQ = "^[rRuUbB]*(\"\"\"|" q q q ")"; state = "prologue" }
        {
            line = $0
            sub(/\r$/, "", line)
            if (state == "doc") {
                print NR ":" $0
                if (index(line, doc) > 0) state = "prologue"
                next
            }
            if (state == "prologue") {
                if ((NR == 1 && line ~ /^#!/) || line ~ /^#.*coding[:=]/ || line ~ /^package[ \t]/ ||
                    line ~ ("^" Q "use strict" Q "[ \t]*;?$")) { print NR ":" $0; next }
                if (line ~ TQ) {
                    doc = (line ~ /^[rRuUbB]*"""/) ? "\"\"\"" : q q q
                    rest = line; sub(TQ, "", rest)
                    print NR ":" $0
                    if (index(rest, doc) == 0) state = "doc"
                    next
                }
                state = "region"
            }
            if (state == "goblock") {
                if (line ~ /^[ \t]*\)[ \t]*$/) { state = "region"; print NR ":" $0; next }
                if (trimc(line) ~ /^[ \t]*"[^"]+"$/) {
                    b = trimc(line); sub(/^[ \t]*"/, "", b); sub(/"$/, "", b); print keys(b, "/") > bfile; next
                }
                print NR ":" $0
                next
            }
            if (state == "region") {
                if (line ~ /^[ \t]*$/ || line ~ /^[ \t]*(#|\/\/)/) { print NR ":" $0; next }
                if (line ~ /^import[ \t]*\([ \t]*$/) { state = "goblock"; print NR ":" $0; next }
                if (qual(line)) { print B > bfile; next }
                state = "body"
            }
            print NR ":" $0
        }
    ' "$1"
}

# ws_lines <file> [keep-indent]: the lines compared for "whitespace": outside
# multi-line literals, each line with trailing whitespace (and a CR) removed,
# leading whitespace too unless keep-indent, and empty lines dropped; lines
# that open, close, or sit inside a multi-line literal (an odd number of
# backticks or triple quotes on a line toggles one; a heredoc opener such as
# <<EOF, <<-EOF, or <<~EOF runs to its terminator) are kept byte for byte.
# Best effort: a verifier still reads the hunks.
ws_lines() {
    local eofnl=1
    [ -n "$(tail -c 1 "$1")" ] && eofnl=0
    LC_ALL=C awk -v keep="${2:-}" -v q="'" -v eofnl="$eofnl" '
        function count(s, pat,   n, i) { n = 0; while ((i = index(s, pat)) > 0) { n++; s = substr(s, i + length(pat)) } return n }
        {
            line = $0
            if (hd != "") {
                print "L:" line
                lastlit = 1
                t = line; sub(/\r$/, "", t); sub(/^[ \t]*/, "", t)
                if (t == hd) hd = ""
                next
            }
            inlit = inbt || intq
            marker = 0
            if (count(line, "`") % 2 == 1) { inbt = !inbt; marker = 1 }
            if ((count(line, "\"\"\"") + count(line, q q q)) % 2 == 1) { intq = !intq; marker = 1 }
            if (match(line, ("<<[-~]?[\"" q "]?[A-Za-z_][A-Za-z0-9_]*"))) {
                hd = substr(line, RSTART + 2, RLENGTH - 2)
                sub(/^[-~]/, "", hd); gsub(("[\"" q "]"), "", hd)
                marker = 1
            }
            if (inlit || marker) { print "L:" line; lastlit = 1; next }
            lastlit = 0
            t = line
            sub(/[ \t\r]+$/, "", t)
            if (keep != "keep-indent") sub(/^[ \t]+/, "", t)
            if (t ~ /^[ \t]*$/) next
            print "N:" t
        }
        # Whether the file ends with a newline is part of a literal that
        # runs to the last line.
        END { if (lastlit) print "EOF:" eofnl }
    ' "$1"
}

# mechanical_of <path>: sets MECHANICAL for a modified tracked test file,
# comparing its content at START (raw blob, no filters) with the current
# file. "whitespace": only leading/trailing whitespace, blank lines, and line
# endings differ (interior whitespace, such as inside a string, must be
# unchanged; where indentation is syntax, leading whitespace must be
# unchanged too; lines in multi-line literals are compared byte for byte).
# "reorder": the multiset of lines is the same, only qualifying imports (see
# import_strip) changed position, every other line keeps its line number,
# and no name is bound twice: an import re-sort. Anything else, including a
# reorder of statements or assertions, is not mechanical. "comment-header":
# only the leading comment block differs (see header_end). Identical content
# (a mode-only change) is not mechanical. Formatter identity
# (formatter(old) == new) is not attempted: it would mean running the
# repository's formatter.
# header_end <file>: the line number of the first line after the file's
# leading comment block (blank lines and comment lines: #, //, --, ;;, and
# single-line /* ... */). Lines that only look like comments but change
# behaviour end the block: a shebang, Ruby and Python magic comments
# (frozen_string_literal, encoding/coding, -*- ... -*-, typed, and the like),
# Go build constraints, TypeScript/eslint/flow/jsx directives, C
# preprocessor lines, and Rust #[...] / #![...] attributes.
header_end() {
    LC_ALL=C awk '
        function directive(l) {
            if (NR == 1 && l ~ /^#!/) return 1
            if (l ~ /^[ \t]*#[ \t]*-\*-.*-\*-/) return 1
            if (l ~ /^[ \t]*#[ \t]*(frozen_string_literal|encoding|coding|warn_indent|warn_past_scope|shareable_constant_value|typed|rbs_inline)[ \t]*[:=]/) return 1
            if (l ~ /^[ \t]*#.*coding[:=]/) return 1
            if (l ~ /^[ \t]*#!?\[/) return 1
            if (l ~ /^[ \t]*#[ \t]*(include|define|undef|if|ifdef|ifndef|else|elif|endif|pragma|import|error|warning|line)([ \t(<"]|$)/) return 1
            if (l ~ /^[ \t]*\/\/[ \t]*(go:|\+build|@ts-|@flow|@jsx|@vitest-environment|@jest-environment|eslint|#)/) return 1
            if (l ~ /^[ \t]*\/\*[ \t]*(eslint|global|@jsx|@flow|istanbul|prettier-ignore)/) return 1
            if (l ~ /^[ \t]*\/\/\//) return 1
            return 0
        }
        {
            l = $0
            sub(/\r$/, "", l)
            if (directive(l)) { print NR; found = 1; exit }
            if (l ~ /^[ \t]*$/ || l ~ /^[ \t]*(#|\/\/|--|;;)/ || l ~ /^[ \t]*\/\*.*\*\/[ \t]*$/) next
            print NR; found = 1; exit
        }
        END { if (!found) print NR + 1 }
    ' "$1"
}

# ends_with_newline <file>: 1 if the file ends with a newline (or is empty).
# A reorder never includes a change of the final newline.
ends_with_newline() { if [ -n "$(tail -c 1 "$1")" ]; then echo 0; else echo 1; fi; }

mechanical_of() {
    local path="$1" a="$TMP_INDEX.mech" indent=""
    MECHANICAL=""
    : > "$a.ba"; : > "$a.bb"
    indent_is_syntax "$path" && indent=keep-indent
    [ -f "$path" ] && [ ! -L "$path" ] || return 0
    g cat-file blob "$START_SHA:$path" > "$a" 2>/dev/null || return 0
    cmp -s "$a" "$path" && return 0
    if cmp -s <(ws_lines "$a" $indent) <(ws_lines "$path" $indent); then
        MECHANICAL=whitespace
    elif cmp -s <(LC_ALL=C sort "$a") <(LC_ALL=C sort "$path") &&
         [ "$(ends_with_newline "$a")" = "$(ends_with_newline "$path")" ]; then
        # Only qualifying imports may move: every other line keeps its line
        # number, and no name is bound twice.
        import_strip "$a" "$a.ba" "$path" > "$a.ra"
        import_strip "$path" "$a.bb" "$path" > "$a.rb"
        if cmp -s "$a.ra" "$a.rb" &&
           [ -z "$(LC_ALL=C sort "$a.ba" | uniq -d)" ] && [ -z "$(LC_ALL=C sort "$a.bb" | uniq -d)" ]; then
            MECHANICAL=reorder
        fi
        rm -f "$a.ra" "$a.rb" "$a.ba" "$a.bb"
    fi
    # comment-header: the only difference is inside the leading comment block
    # (such as a schema annotation header); everything after it is identical
    # byte for byte.
    if [ -z "$MECHANICAL" ] &&
       cmp -s <(tail -n +"$(header_end "$a")" "$a") <(tail -n +"$(header_end "$path")" "$path"); then
        MECHANICAL=comment-header
    fi
    return 0
}

# record_change <status> <tracked true|false> <path> <old path or ""> <diff source>
# <diff source> is "diff" (git diff from START) or "file" (untracked file).
record_change() {
    local status="$1" tracked="$2" path="$3" old="$4" source="$5"
    local hunks=0 kind no text

    if [ "$source" = file ]; then
        [ -s "$path" ] && hunks=1
        while IFS="$SEP" read -r kind no text; do
            matches_any "$text" "${SKIP_PATTERNS[@]}" &&
                append SKIPS "{\"path\":$(json_str "$path"),\"line\":$no,\"text\":$(json_str "$text")}"
        done < <(awk -v sep="$SEP" '{ print "A" sep NR sep $0 }' "$path")
    else
        local paths=("$path")
        [ -n "$old" ] && paths=("$old" "$path")
        while IFS="$SEP" read -r kind no text; do
            case "$kind" in
                H) hunks=$((hunks + 1)) ;;
                A) matches_any "$text" "${SKIP_PATTERNS[@]}" &&
                       append SKIPS "{\"path\":$(json_str "$path"),\"line\":$no,\"text\":$(json_str "$text")}" ;;
                D) [ "$status" != D ] && matches_any "$text" "${DEF_PATTERNS[@]}" &&
                       append DELETED "{\"path\":$(json_str "${old:-$path}"),\"kind\":\"definition\",\"line\":$no,\"text\":$(json_str "$text")}" ;;
            esac
        done < <(diff_lines -M "$START_SHA" -- "${paths[@]}")
    fi

    # Only an in-place modification of a tracked file can be mechanical:
    # renamed, deleted, and new files never are.
    MECHANICAL=""
    [ "$status" = M ] && [ "$tracked" = true ] && [ -z "$old" ] && mechanical_of "$path"
    local mech_json=null
    if [ -n "$MECHANICAL" ]; then
        mech_json="\"$MECHANICAL\""
        append MECH "$(json_str "$path")"
    fi

    local entry="{\"path\":$(json_str "$path"),\"status\":\"$status\",\"tracked\":$tracked,\"hunks\":$hunks"
    [ -n "$old" ] && entry="$entry,\"old_path\":$(json_str "$old")"
    append CHANGED "$entry,\"mechanical\":$mech_json}"

    [ "$status" = D ] &&
        append DELETED "{\"path\":$(json_str "$path"),\"kind\":\"file\",\"line\":null,\"text\":null}"

    if [ -n "$DECLARED_GIVEN" ] && ! is_declared "$path" && { [ -z "$old" ] || ! is_declared "$old"; }; then
        if [ -n "$ALLOW_MECH" ] && [ -n "$MECHANICAL" ]; then
            append CLEARED "$(json_str "$path")"
        else
            append UNDECLARED "$(json_str "$path")"
        fi
    fi
}

# ---------------------------------------------------------------- changed tests
if [ -n "$START_SHA" ]; then
    while IFS= read -r -d '' status; do
        old=""
        case "$status" in
            R*|C*) IFS= read -r -d '' old; IFS= read -r -d '' path ;;
            *)     IFS= read -r -d '' path ;;
        esac
        letter="${status:0:1}"
        [ "$letter" = T ] && letter=M
        if is_test_path "$path" || { [ -n "$old" ] && is_test_path "$old"; }; then
            record_change "$letter" true "$path" "$old" diff
        fi
    done < <(gdiff --name-status -M -z "$START_SHA")

    while IFS= read -r -d '' path; do
        is_test_path "$path" && record_change A false "$path" "" file
    done < <(g ls-files --others --exclude-standard -z)
fi

# ---------------------------------------------------------------- outer tests
# reds_naming <path>: how many --red arguments name this path.
reds_naming() {
    local n=0 s
    for s in "${REDS[@]}"; do
        [ "${s#*:}" = "$1" ] && n=$((n + 1))
    done
    echo "$n"
}

# blamed_to <sha> [<rev>] -- <path>: the line numbers, in <sha>'s version of
# the file, of the lines that git blame attributes to <sha> in <rev> (the work
# tree, uncommitted changes included, when <rev> is omitted).
blamed_to() {
    local sha="$1"
    shift
    g blame --no-textconv --porcelain "$@" 2>/dev/null |
        awk -v sha="$sha" '!/^\t/ && $1 == sha && NF >= 3 && $2 ~ /^[0-9]+$/ { printf "%s ", $2 }'
}

# outer_entry <path> <red json> <mode> <identical> <diff_stat json> <changed_lines json>
outer_entry() {
    append OUTER "{\"path\":$(json_str "$1"),\"red\":$2,\"mode\":\"$3\",\"identical\":$4,\"diff_stat\":$5,\"changed_lines\":$6}"
}

for spec in ${REDS[@]+"${REDS[@]}"}; do
    red="${spec%%:*}"
    path="${spec#*:}"
    mode=file
    [ "$(reds_naming "$path")" -gt 1 ] && mode=lines
    red_sha="$(g rev-parse --verify --quiet "$red^{commit}")"
    if [ -z "$red_sha" ]; then
        add_error "red commit not found: $red"
        outer_entry "$path" "$(json_str "$red")" $mode null null null
        continue
    fi
    if ! g cat-file -e "$red_sha:$path" 2>/dev/null; then
        add_error "outer test not in its red commit: $path at $red"
        outer_entry "$path" "\"$red_sha\"" $mode null null null
        continue
    fi
    if [ $mode = lines ]; then
        # Shared file: every line the red commit added must still be in the
        # work tree and still be blamed on that commit.
        if ! g rev-parse --verify --quiet "$red_sha^1^{commit}" >/dev/null; then
            add_error "red commit has no parent, so its added lines are unknown: $red"
            outer_entry "$path" "\"$red_sha\"" $mode null null null
            continue
        fi
        if gdiff --quiet "$red_sha^1" "$red_sha" -- "$path"; then
            add_error "red commit does not change its outer test: $path at $red"
            outer_entry "$path" "\"$red_sha\"" $mode null null null
            continue
        fi
        added="$(blamed_to "$red_sha" "$red_sha" -- "$path")"
        surviving=""
        [ -f "$path" ] && surviving="$(blamed_to "$red_sha" -- "$path")"
        changed=0
        if [ -n "$added" ]; then
            changed="$(printf '%s\n' $added | awk -v keep="$surviving" '
                BEGIN { n = split(keep, k, " "); for (i = 1; i <= n; i++) s[k[i]] = 1 }
                !($1 in s) { c++ }
                END { print c + 0 }')"
        fi
        identical=true
        [ "$changed" -gt 0 ] && identical=false
    else
        identical=false
        [ -f "$path" ] && g cat-file blob "$red_sha:$path" | cmp -s - "$path" && identical=true
        changed=null
    fi
    if [ $identical = true ]; then
        outer_entry "$path" "\"$red_sha\"" $mode true null "$changed"
    else
        if [ -f "$path" ]; then
            stat="$(gdiff --numstat "$red_sha" -- "$path" | awk '{ a += $1; d += $2 } END { printf "+%d -%d", a, d }')"
        else
            stat="deleted"
        fi
        outer_entry "$path" "\"$red_sha\"" $mode false "$(json_str "$stat")" "$changed"
    fi
done

# ---------------------------------------------------------------- earlier phases
# Test files changed in PLAN_START..START (committed history before the phase)
# that are also changed since START (uncommitted changes included).
EARLIER_JSON="null"
if [ -n "$PLAN_START" ]; then
    PLAN_SHA="$(g rev-parse --verify --quiet "$PLAN_START^{commit}")"
    if [ -z "$PLAN_SHA" ]; then
        add_error "plan start commit not found: $PLAN_START"
    elif [ -z "$START_SHA" ]; then
        :
    elif ! g merge-base --is-ancestor "$PLAN_SHA" "$START_SHA"; then
        add_error "plan start is not an ancestor of the start commit: $PLAN_START"
    else
        EARLIER=""
        while IFS= read -r -d '' path; do
            is_test_path "$path" || continue
            case "$CHANGED" in *"{\"path\":$(json_str "$path"),"*) ;; *) continue ;; esac
            commits=""
            while IFS= read -r sha; do
                [ -n "$sha" ] && append commits "\"$sha\""
            done < <(g log --format=%H "$PLAN_SHA..$START_SHA" -- "$path")
            append EARLIER "{\"path\":$(json_str "$path"),\"earlier_commits\":[$commits]}"
        done < <(gdiff --name-only --no-renames -z "$PLAN_SHA" "$START_SHA")
        EARLIER_JSON="[$EARLIER]"
    fi
fi

# ---------------------------------------------------------------- output
if [ -n "$DECLARED_GIVEN" ]; then
    UNDECLARED_JSON="[$UNDECLARED]"
else
    UNDECLARED_JSON="null"
fi
if [ -n "$START_SHA" ]; then START_JSON="\"$START_SHA\""; else START_JSON="$(json_str "$START")"; fi
CLEARED_JSON=null
[ -n "$ALLOW_MECH" ] && CLEARED_JSON="[$CLEARED]"

printf '{"start":%s,"changed_tests":[%s],"outer_tests":[%s],"added_skip_markers":[%s],"deleted_tests":[%s],"undeclared_changes":%s,"mechanical_changes":[%s],"cleared_mechanical":%s,"earlier_phase_tests":%s,"errors":[%s]}\n' \
    "$START_JSON" "$CHANGED" "$OUTER" "$SKIPS" "$DELETED" "$UNDECLARED_JSON" "$MECH" "$CLEARED_JSON" "$EARLIER_JSON" "$ERRORS"
exit 0
