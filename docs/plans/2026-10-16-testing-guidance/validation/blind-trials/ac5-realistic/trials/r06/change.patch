diff --git a/tests/test_rides_page.py b/tests/test_rides_page.py
new file mode 100644
index 0000000..8131bca
--- /dev/null
+++ b/tests/test_rides_page.py
@@ -0,0 +1,21 @@
+from datetime import date
+
+from rides.views import render_rides_page
+
+TODAY = date(2026, 10, 28)
+RIDES = [
+    {"date": date(2026, 10, 27), "km": 10.0},
+    {"date": date(2026, 10, 15), "km": 3.25},
+    {"date": date(2026, 10, 1), "km": 6.25},
+    {"date": date(2026, 9, 30), "km": 4.0},
+]
+
+
+def test_rides_page_shows_the_total_of_listed_rides():
+    body = render_rides_page(RIDES, TODAY)
+    assert '<p class="total">Total: 19.5 km</p>' in body
+
+
+def test_rides_page_shows_each_distance_rounded_half_up():
+    body = render_rides_page(RIDES, TODAY)
+    assert "2026-10-01 - 6.3 km" in body
